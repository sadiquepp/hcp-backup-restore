<network>
  <name>default</name>
  <uuid>467059b1-29f1-4bfc-bb9a-1b5ae26d244c</uuid>
  <forward mode='nat'>
    <nat>
      <port start='1024' end='65535'/>
    </nat>
  </forward>
  <bridge name='virbr0' stp='on' delay='0'/>
  <mac address='52:54:00:c7:82:0c'/>
  <dns>
    <forwarder domain='{{ hub_domain }}' addr='{{ lab_network_prefix }}.{{ ip_list.helper_server}}'/>
{# One forwarder per hosted cluster zone, connected and disconnected alike,
   derived from the cluster lists so the set here can never drift from the
   zones roles/setup-dns actually serves. A missing forwarder is why a name
   like api.hcp-cluster1-d.mylab.com resolves from the helper but not from a
   VM on this network. #}
{% for hcp_zone_name in (hosted_clusters | default([]) | select('mapping') | map(attribute='name') | list)
                        + (hosted_clusters | default([]) | reject('mapping') | list)
                        + (hosted_clusters_disconnected | default([]) | select('mapping') | map(attribute='name') | list)
                        + (hosted_clusters_disconnected | default([]) | reject('mapping') | list) %}
    <forwarder domain='{{ hcp_zone_name }}.{{ base_domain }}' addr='{{ lab_network_prefix }}.{{ ip_list.helper_server }}'/>
{% endfor %}
    <forwarder domain='{{ hub2_domain }}' addr='{{ lab_network_prefix }}.{{ ip_list.helper_server }}'/>
    <forwarder domain='{{ hub_disconnected_domain }}' addr='{{ lab_network_prefix }}.{{ ip_list.helper_server }}'/>
    <forwarder domain='{{ lab_network_reverse_zone }}' addr='{{ lab_network_prefix }}.{{ ip_list.helper_server }}'/>
  </dns>
  <ip address='{{ lab_network_prefix }}.1' netmask='{{ lab_network_netmask }}'>
    <dhcp>
     <range start="{{ lab_network_prefix }}.201" end="{{ lab_network_prefix }}.249"/>
{# DHCP host FQDNs must match roles/setup-dns/templates/named-reverse.hub.j2 PTRs #}
{# ip_list key -> the hosted cluster it belongs to, inverted from
   hosted_cluster_node_keys so the macro below stays one branch regardless of
   how many hosted clusters exist. #}
{% set hosted_cluster_worker_zone = {} %}
{% for hcp_name, hcp_keys in (hosted_cluster_node_keys | default({})).items() %}
{% for key in hcp_keys.workers | default([]) %}
{% set _ = hosted_cluster_worker_zone.update({key: hcp_name}) %}
{% endfor %}
{% endfor %}
{% macro dhcp_fqdn(key) -%}
{%- if key == 'helper_server' -%}
helper.{{ hub_domain }}
{%- elif key == 'bootstrap' -%}
bootstrap.{{ hub_domain }}
{%- elif key == 'hub2_bootstrap' -%}
bootstrap.{{ hub2_domain }}
{%- elif key.startswith('hub2_') -%}
{{ key | regex_replace('^hub2_', '') }}.{{ hub2_domain }}
{%- elif key == 'hubd_bootstrap' -%}
bootstrap.{{ hub_disconnected_domain }}
{%- elif key.startswith('hubd_') -%}
{{ key | regex_replace('^hubd_', '') }}.{{ hub_disconnected_domain }}
{%- elif key in hosted_cluster_worker_zone -%}
{#- Hosted cluster worker VMs: the cluster whose hosted_cluster_node_keys list
    the key belongs to, so a new cluster or a '-d' one needs no branch here. -#}
{{ key }}.{{ hosted_cluster_worker_zone[key] }}.{{ base_domain }}
{%- elif key == 'hublb' -%}
api.{{ hub_domain }}
{%- elif key == 'hub2lb' -%}
api.{{ hub2_domain }}
{%- elif key == 'hubdlb' -%}
api.{{ hub_disconnected_domain }}
{%- else -%}
{{ key }}.{{ hub_domain }}
{%- endif -%}
{%- endmacro %}
     {% for key, value in ip_list.items() %}
     <host mac='52:54:00:e2:54:{{ value }}' name='{{ dhcp_fqdn(key) }}' ip='{{ lab_network_prefix }}.{{ value }}'/>
     {% endfor %}
     <bootp file='pxelinux.0' server='{{ lab_network_prefix }}.{{ ip_list.helper_server }}'/>
   </dhcp>
  </ip>
</network>
