kind: Secret
apiVersion: v1
metadata:
  name: pullsecret-{{ oadp_bminfra_namespace }}
  namespace: "{{ oadp_bminfra_namespace }}"
data:
  # bminfra_pull_secret, not pull_secret directly: it is vault.yaml's pull_secret
  # on a connected hub (defaults/main.yml) and the mirror registry's own
  # credentials on a disconnected one (tasks/disconnected-pull-secret.yml).
  '.dockerconfigjson': '{{ bminfra_pull_secret | b64encode }}'
type: 'kubernetes.io/dockerconfigjson'
