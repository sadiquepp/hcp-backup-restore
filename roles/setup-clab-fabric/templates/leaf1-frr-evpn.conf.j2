{#
  Border leaf in the EVPN topology.

  Same cluster-facing role as the non-EVPN leaf config - the untagged
  default-VRF session and the per-tenant VLAN sessions are unchanged, so the
  cluster side does not have to be rebuilt to move from phase 3 to phase 4.
  What is added is the overlay: an underlay session to the spine, an l2vpn
  evpn session to the spine, and a per-VRF 'advertise ipv4 unicast' that
  injects each tenant's routes into EVPN as type-5 prefixes.
#}
frr version 10.2
frr defaults datacenter
hostname leaf1
log stdout
service integrated-vtysh-config
!
{# Each tenant VRF is bound to its L3VNI. FRR reads this to know which VNI to
   encapsulate the VRF's traffic in; it has to match the VXLAN device created
   in the topology's exec block and the ipVRF vni on the cluster's CUDN. #}
{% for t in udn_bgp_tenants %}
vrf {{ t.name }}
 vni {{ t.evpn_ip_vni }}
exit-vrf
!
{% endfor %}
ip prefix-list LAB-MGMT seq 5 permit {{ lab_network_prefix }}.0/24 le 32
!
route-map FROM-CLUSTER deny 5
 match ip address prefix-list LAB-MGMT
route-map FROM-CLUSTER permit 10
!
route-map TO-CLUSTER deny 5
 match ip address prefix-list LAB-MGMT
route-map TO-CLUSTER permit 10
!
! ---------------------------------------------------------------------------
! Default VRF: underlay to the spine, EVPN overlay, and the cluster session
! ---------------------------------------------------------------------------
router bgp {{ clab_leaf1_asn }}
 bgp router-id 10.0.0.1
 no bgp ebgp-requires-policy
 bgp log-neighbor-changes
 ! Underlay - eBGP to the spine, carries loopbacks so VTEPs can find each
 ! other.
 neighbor 10.1.0.2 remote-as {{ clab_spine_asn }}
 neighbor 10.1.0.2 description spine-underlay
 ! Overlay - the EVPN session, sourced from the loopback and multihop because
 ! it is not on the point-to-point link.
 neighbor 10.0.0.254 remote-as {{ clab_spine_asn }}
 neighbor 10.0.0.254 description spine-evpn
 neighbor 10.0.0.254 update-source lo0
 neighbor 10.0.0.254 ebgp-multihop 3
{% for n in clab_fabric_nodes %}
 neighbor {{ clab_fabric_prefix }}.{{ ip_list[n.ip_key] }} remote-as {{ clab_cluster_asn }}
 neighbor {{ clab_fabric_prefix }}.{{ ip_list[n.ip_key] }} description {{ n.node }}
{% endfor %}
 !
 address-family ipv4 unicast
  ! The loopback is what every EVPN next hop points at, so it has to be
  ! reachable across the underlay.
  network 10.0.0.1/32
  neighbor 10.1.0.2 activate
{% for n in clab_fabric_nodes %}
  neighbor {{ clab_fabric_prefix }}.{{ ip_list[n.ip_key] }} activate
  neighbor {{ clab_fabric_prefix }}.{{ ip_list[n.ip_key] }} route-map FROM-CLUSTER in
  neighbor {{ clab_fabric_prefix }}.{{ ip_list[n.ip_key] }} route-map TO-CLUSTER out
{% endfor %}
  ! The EVPN peer must NOT be activated for ipv4 unicast - it carries l2vpn
  ! evpn only. Activating both is a common way to end up with two paths for
  ! the same prefix and non-deterministic forwarding.
  no neighbor 10.0.0.254 activate
 exit-address-family
 !
 address-family l2vpn evpn
  neighbor 10.0.0.254 activate
  ! The cluster's own VTEPs (OpenShift {{ udn_bgp_evpn_min_version }}+) and the
  ! leaves all sit in different ASNs, so EVPN routes that have already passed
  ! through this ASN have to be accepted back.
  neighbor 10.0.0.254 allowas-in origin
  ! Advertise every locally-detected VNI. FRR finds them from the VXLAN and
  ! bridge netdevs created in the topology's exec block.
  advertise-all-vni
 exit-address-family
exit
!
{% for t in udn_bgp_tenants %}
! ---------------------------------------------------------------------------
! VRF {{ t.name }} - VLAN {{ t.vlan }} to the cluster, VNI {{ t.evpn_ip_vni }} into the fabric
! ---------------------------------------------------------------------------
router bgp {{ clab_leaf1_asn }} vrf {{ t.name }}
 bgp router-id {{ t.vrf_prefix }}.{{ clab_fabric_router_octet }}
 no bgp ebgp-requires-policy
 bgp log-neighbor-changes
{% for n in clab_fabric_nodes %}
 neighbor {{ t.vrf_prefix }}.{{ ip_list[n.ip_key] }} remote-as {{ clab_cluster_asn }}
 neighbor {{ t.vrf_prefix }}.{{ ip_list[n.ip_key] }} description {{ n.node }} ({{ t.name }})
{% endfor %}
 !
 address-family ipv4 unicast
{% for n in clab_fabric_nodes %}
  neighbor {{ t.vrf_prefix }}.{{ ip_list[n.ip_key] }} activate
  neighbor {{ t.vrf_prefix }}.{{ ip_list[n.ip_key] }} route-map FROM-CLUSTER in
{% endfor %}
 exit-address-family
 !
 address-family l2vpn evpn
  ! Take everything this VRF knows - the cluster's advertised UDN subnets
  ! included - and originate it into EVPN as type-5 routes carrying VNI
  ! {{ t.evpn_ip_vni }}. This is the handoff: VRF-Lite on the cluster side,
  ! EVPN on the fabric side.
  advertise ipv4 unicast
  route-target import {{ clab_spine_asn }}:{{ t.evpn_ip_vni }}
  route-target export {{ clab_spine_asn }}:{{ t.evpn_ip_vni }}
 exit-address-family
exit
!
{% endfor %}
line vty
!
