# Per-tenant client VMs, rendered by setup-clab-fabric from udn_tenant_clients.
#
# Read by scripts/udn-vrf-isolation.sh --vms so the script needs no YAML
# parser and cannot drift from vars.yaml. One line per client:
#
#   name|management-ip|tenant[,tenant...]
#
{% for c in udn_tenant_clients %}
{{ c.name }}|{{ lab_network_prefix }}.{{ ip_list[c.name] }}|{{ c.tenants | join(',') }}
{% endfor %}
