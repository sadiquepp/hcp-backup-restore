# The tenant ingress, rendered by setup-clab-fabric.
# Read by scripts/udn-web-demo.sh --proxy.
#
#   vm-name|management-ip|port|domain|tenant:backend-address[,tenant:backend-address...]
#
# The backend addresses are what each tenant's pod held when this was rendered.
# They are recorded so the demo can tell a stale config from a routing fault:
# any --tags web re-run replaces the pods, changes their addresses, and leaves
# this file - and the haproxy config it describes - behind.
{{ udn_nsclient_vm_name }}|{{ udn_proxy_bind_addr }}|{{ udn_proxy_port }}|{{ udn_proxy_domain }}|{% for t in udn_proxy_tenants %}{{ t }}:{{ udn_proxy_backend_addrs[t] }}{% if not loop.last %},{% endif %}{% endfor %}
