{# api/api-int are the hosted cluster's kube-apiserver VIP, handed out by
   MetalLB on the hub. The address comes from hosted_cluster_metallb_pools
   (vars.yaml), the same map that defines the single-address IPAddressPool
   bound to this cluster's control-plane namespace - so this zone and that
   pool can never drift apart. The leading label of hosted_domain3 is the
   HostedCluster name, which is how the two are keyed together. -#}
{% set hcp_name = hosted_domain3.split('.') | first -%}
$TTL 1D
@	IN SOA	helper.{{ hub_domain }}. root.{{hub_domain }}. (
					0	; serial
					1D	; refresh
					1H	; retry
					1W	; expire
					3H )	; minimum
		NS	helper.{{ hub_domain }}.
worker1		A	{{ lab_network_prefix }}.{{ ip_list.c3worker1 }}
worker2		A	{{ lab_network_prefix }}.{{ ip_list.c3worker2 }}
worker3		A	{{ lab_network_prefix }}.{{ ip_list.c3worker3 }}
api		A	{{ lab_network_prefix }}.{{ hosted_cluster_metallb_pools[hcp_name].ip }}
api-int		A	{{ lab_network_prefix }}.{{ hosted_cluster_metallb_pools[hcp_name].ip }}
*.apps		A	{{ lab_network_prefix }}.{{ ip_list.c3lb }}

