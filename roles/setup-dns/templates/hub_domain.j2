$TTL 1D
@	IN SOA	helper.{{ hub_domain }}. root.{{hub_domain }}. (
					0	; serial
					1D	; refresh
					1H	; retry
					1W	; expire
					3H )	; minimum
		NS	helper.{{ hub_domain }}.
helper		A	{{ lab_network_prefix }}.{{ ip_list.helper_server}}
registry		A	{{ lab_network_prefix }}.{{ ip_list.registry}}
minio		A	{{ lab_network_prefix }}.{{ ip_list.minio}}
bootstrap	A	{{ lab_network_prefix }}.{{ ip_list.bootstrap }}
master1		A	{{ lab_network_prefix }}.{{ ip_list.master1}}
master2		A	{{ lab_network_prefix }}.{{ ip_list.master2}}
master3		A	{{ lab_network_prefix }}.{{ ip_list.master3}}
worker1		A	{{ lab_network_prefix }}.{{ ip_list.worker1}}
worker2		A	{{ lab_network_prefix }}.{{ ip_list.worker2}}
worker3		A	{{ lab_network_prefix }}.{{ ip_list.worker3}}
ceph1		A	{{ lab_network_prefix }}.{{ ip_list.ceph1}}
ceph2		A	{{ lab_network_prefix }}.{{ ip_list.ceph2}}
ceph3		A	{{ lab_network_prefix }}.{{ ip_list.ceph3}}
cephadmin		A	{{ lab_network_prefix }}.{{ ip_list.cephadmin}}
api		A	{{ lab_network_prefix }}.{{ ip_list.hublb}}
api-int		A	{{ lab_network_prefix }}.{{ ip_list.hublb}}
*.apps		A	{{ lab_network_prefix }}.{{ ip_list.hublb}}
{% if (udn_proxy_names | default('') | trim) and ip_list.get(udn_nsclient_vm_name | default('')) %}
;
; Tenant ingress for the UDN lab (--tags clabnsproxy). One name per tenant per
; cluster, every one of them the same address: the proxy picks the route from
; the Host header, not from where the name points. That is the whole trick -
; green and purple resolve to one address AND dial one backend address and
; still return different pages, because haproxy makes each connection inside a
; different network namespace.
;
; Once a second cluster is on the fabric the same applies across clusters:
; green-sno resolves here too, is served out of the green namespace, and on a
; stretched L2VNI its backend address can be identical to purple-sno's.
;
; Generated from udn_proxy_names, which is where the naming rule lives, so this
; zone cannot drift from the haproxy config that setup-clab-fabric renders from
; the same variable. Generating it from the TENANT list instead was the bug: a
; hostname that resolves and 404s reads as a proxy fault and is not one.
; Skipped entirely when the UDN lab vars are not loaded.
{% for n in udn_proxy_names.split() %}
{{ "%-15s" | format(n) }}A	{{ lab_network_prefix }}.{{ ip_list[udn_nsclient_vm_name] }}
{% endfor %}
{% endif %}
