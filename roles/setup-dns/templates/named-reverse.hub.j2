$TTL    600
@   IN SOA  helper.{{ hub_domain }}. admin.root.{{ hub_domain }}. (
                     2019082200   ; serial
                     1800  ; refresh
                     1800  ; retry
                     604800  ; expire
                     86400 )    ; minimum

@ 					IN NS 	helper.{{ hub_domain }}.
{{ ip_list.helper_server }}   		IN PTR 		helper.{{ hub_domain }}.
{{ ip_list.registry }}   		IN PTR 		registry.{{ hub_domain }}.
{{ ip_list.minio }}   		IN PTR 		minio.{{ hub_domain }}.
{{ ip_list.bootstrap }} 		IN PTR 		bootstrap.{{ hub_domain }}.
{{ ip_list.master1 }} 		IN PTR 		master1.{{ hub_domain }}.
{{ ip_list.master2 }} 		IN PTR 		master2.{{ hub_domain }}.
{{ ip_list.master3 }} 		IN PTR 		master3.{{ hub_domain }}.
{{ ip_list.worker1 }} 		IN PTR 		worker1.{{ hub_domain }}.
{{ ip_list.worker2 }} 		IN PTR 		worker2.{{ hub_domain }}.
{{ ip_list.worker3 }} 		IN PTR 		worker3.{{ hub_domain }}.
{{ ip_list.hub2_bootstrap }} 		IN PTR 		bootstrap.{{ hub2_domain }}.
{{ ip_list.hub2_master1 }} 		IN PTR 		master1.{{ hub2_domain }}.
{{ ip_list.hub2_master2 }} 		IN PTR 		master2.{{ hub2_domain }}.
{{ ip_list.hub2_master3 }} 		IN PTR 		master3.{{ hub2_domain }}.
{{ ip_list.hub2_worker1 }} 		IN PTR 		worker1.{{ hub2_domain }}.
{{ ip_list.hub2_worker2 }} 		IN PTR 		worker2.{{ hub2_domain }}.
{{ ip_list.hub2_worker3 }} 		IN PTR 		worker3.{{ hub2_domain }}.
{{ ip_list.hubd_bootstrap }} 		IN PTR 		bootstrap.{{ hub_disconnected_domain }}.
{{ ip_list.hubd_master1 }} 		IN PTR 		master1.{{ hub_disconnected_domain }}.
{{ ip_list.hubd_master2 }} 		IN PTR 		master2.{{ hub_disconnected_domain }}.
{{ ip_list.hubd_master3 }} 		IN PTR 		master3.{{ hub_disconnected_domain }}.
{{ ip_list.hubd_worker1 }} 		IN PTR 		worker1.{{ hub_disconnected_domain }}.
{{ ip_list.hubd_worker2 }} 		IN PTR 		worker2.{{ hub_disconnected_domain }}.
{{ ip_list.hubd_worker3 }} 		IN PTR 		worker3.{{ hub_disconnected_domain }}.
{# Hosted cluster worker PTRs for every cluster in either list, rendered only
   for ip_list keys that exist - so the '-d' clusters pick theirs up as soon as
   their worker octets are added, with no edit here. The name each PTR points
   at is the ip_list key, which is also the DHCP reservation's FQDN and now has
   a matching A record in the cluster's forward zone. #}
{% for name in (hosted_clusters | default([]) | select('mapping') | map(attribute='name') | list)
                + (hosted_clusters | default([]) | reject('mapping') | list)
                + (hosted_clusters_disconnected | default([]) | select('mapping') | map(attribute='name') | list)
                + (hosted_clusters_disconnected | default([]) | reject('mapping') | list) %}
{% for key in ((hosted_cluster_node_keys | default({}))[name] | default({})).workers | default([]) %}
{% if key in ip_list %}
{{ ip_list[key] }} 		IN PTR 		{{ key }}.{{ name }}.{{ base_domain }}.
{% endif %}
{% endfor %}
{% endfor %}
{{ ip_list.ceph1 }} 		IN PTR 		ceph1.{{ hub_domain }}.
{{ ip_list.ceph2 }} 		IN PTR 		ceph2.{{ hub_domain }}.
{{ ip_list.ceph3 }} 		IN PTR 		ceph3.{{ hub_domain }}.
{{ ip_list.cephadmin }} 		IN PTR 		cephadmin.{{ hub_domain }}.
