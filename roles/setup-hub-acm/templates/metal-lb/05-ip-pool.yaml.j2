{# One single-address IPAddressPool per hosted cluster, rendered from
   hosted_cluster_metallb_pools (vars.yaml).

   Each pool holds exactly one address and is bound - via serviceAllocation
   - to that hosted cluster's control-plane namespace, so the only Service
   that can ever be given the address is that cluster's kube-apiserver. This
   is what actually keeps a hosted cluster off an address its api/api-int
   records don't point at; the metallb.io/address-pool annotation that
   roles/create-hosted-cluster puts on the HostedCluster records the same
   intent, but HyperShift does not copy HostedCluster annotations onto the
   kube-apiserver Service it creates, so the annotation alone would not bind
   anything.

   NOTE: every pool here is namespace-constrained, and there is no longer an
   unconstrained catch-all pool on the hub. A LoadBalancer Service outside
   these control-plane namespaces will therefore stay <pending> until you
   give it a pool of its own. #}
{% for hcp_name, hcp_pool in hosted_cluster_metallb_pools | dictsort %}
---
apiVersion: metallb.io/v1beta1
kind: IPAddressPool
metadata:
  namespace: metallb-system
  name: {{ hcp_pool.pool }}
spec:
  addresses:
  - {{ lab_network_prefix }}.{{ hcp_pool.ip }}-{{ lab_network_prefix }}.{{ hcp_pool.ip }}
  autoAssign: true
  avoidBuggyIPs: true
  serviceAllocation:
    priority: 10
    namespaces:
      # HostedCluster '{{ hcp_name }}' lives in namespace '{{ hcp_name }}', so
      # HyperShift puts its control plane (and the kube-apiserver Service that
      # asks for this address) in '<namespace>-<name>'.
      - {{ hcp_pool.control_plane_namespace | default(hcp_name ~ '-' ~ hcp_name) }}
{% endfor %}
