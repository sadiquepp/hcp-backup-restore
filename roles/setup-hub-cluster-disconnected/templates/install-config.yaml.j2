apiVersion: v1
baseDomain: "{{base_domain}}"
compute:
- hyperthreading: Enabled
  name: worker
  replicas: 3
controlPlane:
  hyperthreading: Enabled
  name: master
  replicas: 3
metadata:
  name: "{{hub_disconnected_name}}"
networking:
  clusterNetwork:
  - cidr: 10.128.0.0/14
    hostPrefix: 23
  networkType: OVNKubernetes
  serviceNetwork:
  - 172.30.0.0/16
platform:
  none: {}
fips: false
# Only the mirror registry's own credentials are needed here - the ImageDigestMirrorSet
# generated by oc-mirror (copied into manifests/ in tasks/main.yml) redirects every
# release/operator image pull to the mirror registry.
pullSecret: '{{ disconnected_pull_secret }}'
sshKey: '{{ ssh_key }}'
additionalTrustBundle: |
{{ mirror_registry_ca_cert | indent(2, true) }}
