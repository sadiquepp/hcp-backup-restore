{#
  BGP peering for EVPN.

  One session to the border leaf carrying two address families:

    unicast - the underlay. This is how the node learns a route to the other
              VTEPs (leaf2's, and the other nodes') and how leaf1 learns the
              way back. Without it the EVPN session comes up, routes appear
              on both sides, and no tunnel ever forms because neither end can
              reach the other's tunnel endpoint. That failure looks exactly
              like a data-plane problem and is not one.

    evpn    - the overlay. Type-2 and type-5 routes for the tenant networks.

  allowAsIn 'origin' is required, not optional: the OCP nodes and leaf2 both
  sit behind ASNs that the route has already traversed by the time it comes
  back, and without this each end drops the other's routes as a loop.

  This is the CR an admin writes - the peering only. The VNIs, route
  distinguishers and route targets are generated by OVN-Kubernetes into a
  second, additive FRRConfiguration from each CUDN's network.evpn block and
  the RouteAdvertisements CR. Do not hand-write those here; two sources for
  the same VNI is how you get a tunnel that forms and carries nothing.
#}
apiVersion: frrk8s.metallb.io/v1beta1
kind: FRRConfiguration
metadata:
  name: fabric-peering-evpn
  namespace: {{ udn_bgp_frrk8s_namespace }}
  labels:
    {{ udn_bgp_frr_label_key }}: fabric-evpn
spec:
  bgp:
    routers:
      - asn: {{ clab_cluster_asn }}
        neighbors:
          - address: {{ clab_fabric_prefix }}.{{ clab_fabric_router_octet }}
            asn: {{ clab_leaf1_asn }}
            addressFamilies:
              - unicast
              - evpn
            allowAsIn: origin
            holdTime: 9s
            keepaliveTime: 3s
            port: 179
            toReceive:
              allowed:
                mode: all
            toAdvertise:
              allowed:
                {# The VTEP block is what the far end needs in order to build
                   a tunnel back to this node. It is advertised explicitly
                   rather than with mode 'all', which would also put
                   {{ lab_network_prefix }}.0/24 - the lab's management
                   network - into the fabric. #}
                prefixes:
                  - {{ udn_bgp_vtep_prefix }}.0/24
        prefixes:
          - {{ udn_bgp_vtep_prefix }}.0/24
  nodeSelector: {}
