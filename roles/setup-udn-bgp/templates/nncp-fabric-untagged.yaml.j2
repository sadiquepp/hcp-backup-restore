{#
  Address each node's fabric NIC for the untagged, default-VRF BGP session.

  Matched on MAC, not on interface name. The NIC is hot-plugged by
  setup-clab-fabric, so its name depends on PCI enumeration order and on
  whether the node was running at the time; the MAC is assigned by this lab
  and is deterministic. NMState's capture syntax resolves one to the other at
  apply time, which is why there is one policy per node rather than one for
  all of them.

  Note what this policy does NOT do: no gateway, no DNS, no default route,
  no auto-dns, no routes at all. The node keeps reaching everything it
  currently reaches via its virbr0 NIC and {{ lab_network_prefix }}.1. The
  only thing that will ever send traffic out this interface is a route
  learned over BGP from the fabric - which is exactly the property that makes
  this safe to apply to a working cluster.
#}
apiVersion: nmstate.io/v1
kind: NodeNetworkConfigurationPolicy
metadata:
  name: fabric-untagged-{{ node_entry.ip_key }}
spec:
  nodeSelector:
    kubernetes.io/hostname: {{ udn_bgp_node_names[node_entry.ip_key] }}
  capture:
    fabric-nic: interfaces.mac-address=="{{ clab_fabric_mac_prefix | upper }}:{{ ip_list[node_entry.ip_key] }}"
  desiredState:
    interfaces:
      - name: "{{ '{{' }} capture.fabric-nic.interfaces.0.name {{ '}}' }}"
        type: ethernet
        state: up
        # Matches clab_fabric_mtu on the bridge and on the FRR containers.
        # A mismatch here is the classic "BGP is up but nothing works"
        # failure: small packets pass, full-size ones vanish.
        mtu: {{ clab_fabric_mtu }}
        # OVN-Kubernetes turns IP forwarding on per interface - br-ex and
        # ovn-k8s-mpN - and leaves net.ipv4.conf.all.forwarding at 0. Any
        # interface it does not know about therefore inherits
        # conf.default.forwarding, which is also 0, and silently refuses to
        # forward.
        #
        # This NIC has to forward, because that is the entire return path: a
        # reply from the fabric to a pod arrives here and has to reach
        # ovn-k8s-mpN. Without it the kernel drops the packet in the routing
        # decision, and does so without a trace on the wire - the reply is
        # visible on this NIC with tcpdump and never appears on mp0. The only
        # direct evidence is
        #
        #   ip route get <pod ip> from <leaf ip> iif <this nic>
        #   RTNETLINK answers: No route to host
        #
        # which is EHOSTUNREACH, not the ENETUNREACH ("Network is
        # unreachable") the kernel returns when a route is genuinely missing.
        # The route is fine; forwarding is off.
        #
        # Per interface, deliberately. Setting conf.all.forwarding would turn
        # forwarding on for every interface on the node and change the
        # default for new ones, which is a node-wide change to get one NIC
        # working, and it is the posture OVN-Kubernetes has deliberately not
        # taken. Needs nmstate 2.2.51+ (September 2025) for ipv4.forwarding.
        forwarding: true
        ipv4:
          enabled: true
          dhcp: false
          address:
            - ip: {{ clab_fabric_prefix }}.{{ ip_list[node_entry.ip_key] }}
              prefix-length: {{ clab_fabric_netmask_bits }}
        ipv6:
          enabled: false
