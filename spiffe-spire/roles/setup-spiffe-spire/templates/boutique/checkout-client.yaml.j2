{# checkoutservice: payments go to a ghostunnel client on localhost, which
   dials {{ spire_boutique_payment_target }} with this pod's SVID and refuses
   any server that is not {{ spire_boutique_payment_server_id }}. #}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: checkoutservice
spec:
  template:
    spec:
      containers:
        - name: server
          env:
            - name: PAYMENT_SERVICE_ADDR
              value: "localhost:50051"
        - name: ghostunnel
          image: {{ spire_boutique_ghostunnel_image }}
          args:
            - client
            - --listen=localhost:50051
            - --target={{ spire_boutique_payment_target }}
            - --use-workload-api-addr=unix:///spiffe-workload-api/spire-agent.sock
            - --verify-uri={{ spire_boutique_payment_server_id }}
            - --status=0.0.0.0:{{ spire_boutique_status_port }}
          # /_status here performs the whole mTLS dial to the paymentservice,
          # SPIFFE ID check included - a good thing to ASK (verify reads it
          # through the API server's pod proxy), and a bad readiness probe: it
          # would pull checkoutservice out of its Service whenever payments are
          # down. So no probe.
          ports:
            - {name: status, containerPort: {{ spire_boutique_status_port }}}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: {drop: [ALL]}
            readOnlyRootFilesystem: true
            runAsNonRoot: true
            seccompProfile: {type: RuntimeDefault}
          resources:
            {{ spire_boutique_ghostunnel_resources | to_nice_yaml(indent=2) | indent(12) | trim }}
          volumeMounts:
            - {name: spiffe-workload-api, mountPath: /spiffe-workload-api, readOnly: true}
      volumes:
        - name: spiffe-workload-api
          csi: {driver: {{ spire_csi_driver_name }}, readOnly: true}
