# SPIFFE/SPIRE workshop - source this in every new shell, then `lab hub` or
# `lab sno`. Written by spiffe-spire/setup_spiffe_spire.yaml --tags prep.
#
# Everything here is shorthand for a command you could type yourself; `type
# <name>` shows what a helper runs.

export ZT_NS={{ spire_operator_namespace }}          # the operator and its operands
export DEMO_NS={{ spire_demo_namespace }}                             # the demo workloads
export CLASS={{ spire_class_name }}   # spec.className on ClusterSPIFFEID & co.
export LABEL={{ spire_demo_identity_label }}               # the label the registration selects
export HELPER_IMAGE={{ spire_demo_helper_image }}
export PY_IMAGE={{ spire_demo_python_image }}
export APP_DIR={{ role_path }}/files                          # echo_server.py, spiffe_client.py
export WS_MANIFESTS={{ spire_workshop_manifest_root }}
export WS_CLUSTERS={{ spire_workshop_cluster_dir }}

# Part C - Online Boutique
export BQ_NS={{ spire_boutique_namespace }}
export BQ_REPO={{ spire_boutique_repo }}
export BQ_REF={{ spire_boutique_ref }}
export BQ_CLONE={{ spire_boutique_src_dir }}                        # where the repo is cloned
export BQ_SRC=$BQ_CLONE/{{ spire_boutique_path }}   # the app, as the repo ships it
export GHOSTUNNEL_IMAGE={{ spire_boutique_ghostunnel_image }}

# lab hub | lab sno - point oc at that cluster and set $TD, $PEER_TD, $APPS,
# $PEER_APPS, $SPIRE_SC and $M (the directory your manifests go in).
lab() {
    [ -r "$WS_CLUSTERS/$1.env" ] || { echo "no $WS_CLUSTERS/$1.env - run the prep step for $1"; return 1; }
    . "$WS_CLUSTERS/$1.env"
    mkdir -p "$M"
    echo "oc -> $CLUSTER ($TD), manifests in $M"
}

# spire <args> - the spire-server CLI inside the SPIRE server pod
#   same as: oc -n $ZT_NS exec spire-server-0 -c spire-server -- spire-server <args>
spire() { oc -n "$ZT_NS" exec spire-server-0 -c spire-server -- spire-server "$@"; }

# inpod <deployment> <cmd...> - run a command in a demo pod's app container
#   same as: oc -n $DEMO_NS exec deploy/<deployment> -c app -- <cmd...>
inpod() { local d=$1; shift; oc -n "$DEMO_NS" exec "deploy/$d" -c app -- "$@"; }

# call <from> <url> <expected server SPIFFE ID> [--no-cert]
#   same as: inpod <from> python3 /app/spiffe_client.py <url> <id> [--no-cert]
call() { local d=$1; shift; inpod "$d" python3 /app/spiffe_client.py "$@"; }

# bq_status - checkoutservice's ghostunnel /_status, through the API server's
#   pod proxy. backend_ok: a full mTLS handshake to the paymentservice just
#   succeeded, its SPIFFE ID checked.
bq_status() {
    local pod
    pod=$(oc -n "$BQ_NS" get pod -l app=checkoutservice -o jsonpath='{.items[0].metadata.name}') || return 1
    oc get --raw "/api/v1/namespaces/$BQ_NS/pods/http:$pod:{{ spire_boutique_status_port }}/proxy/_status"; echo
}

# svid <deployment> - the SPIFFE ID, validity and issuer of a pod's X.509-SVID
svid() {
    inpod "$1" python3 -c 'import ssl,json; c=ssl._ssl._test_decode_cert("/svid/svid.pem"); print(json.dumps({k:c[k] for k in ("subjectAltName","notBefore","notAfter","issuer")}, indent=1))'
}
