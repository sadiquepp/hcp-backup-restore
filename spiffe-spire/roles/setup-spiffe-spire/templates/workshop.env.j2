# SPIFFE/SPIRE workshop - source this in every new shell, then `lab $FIRST`
# or `lab $SECOND`. Written by spiffe-spire/setup_spiffe_spire.yaml --tags prep.
#
# Everything here is shorthand for a command you could type yourself; `type
# <name>` shows what a helper runs.

# The two clusters, by the names `lab` knows them by: the hub and the SNO in
# this repository's lab, whatever you called them with build-lab.sh --byo.
export FIRST={{ spire_pair[0] }}
export SECOND={{ spire_pair[1] }}
export LAB_DIR={{ playbook_dir }}                          # where build-lab.sh is
{% if spire_byo_vars_file is defined %}
# Your own clusters: build-lab.sh reads them from here when this is set.
export SPIFFE_BYO_VARS={{ spire_byo_vars_file }}
{% endif %}

export ZT_NS={{ spire_operator_namespace }}          # the operator and its operands
export DEMO_NS={{ spire_demo_namespace }}                             # the demo workloads
export CLASS={{ spire_class_name }}   # spec.className on ClusterSPIFFEID & co.
export LABEL={{ spire_demo_identity_label }}               # the label the registration selects
export HELPER_IMAGE={{ spire_demo_helper_image }}
export PY_IMAGE={{ spire_demo_python_image }}
export APP_DIR={{ role_path }}/files                          # echo_server.py, spiffe_client.py
export WS_MANIFESTS={{ spire_workshop_manifest_root }}
export WS_CLUSTERS={{ spire_workshop_cluster_dir }}

# Part C - Online Boutique
export BQ_NS={{ spire_boutique_namespace }}
export BQ_REPO={{ spire_boutique_repo }}
export BQ_REF={{ spire_boutique_ref }}
export BQ_CLONE={{ spire_boutique_src_dir }}                        # where the repo is cloned
export BQ_SRC=$BQ_CLONE/{{ spire_boutique_path }}   # the app, as the repo ships it
export GHOSTUNNEL_IMAGE={{ spire_boutique_ghostunnel_image }}

# Part D - Online Boutique on Service Mesh
export MESH_NS={{ spire_mesh_namespace }}                          # the application
export MESH_CP_NS={{ spire_mesh_control_plane_namespace }}                           # istiod
export MESH_CNI_NS={{ spire_mesh_cni_namespace }}                             # istio-cni-node
export MESH_PKG={{ spire_mesh_operator_package }}
export MESH_OP_NS={{ spire_mesh_operator_namespace }}
export MESH_GW={{ spire_mesh_gateway_name }}
export MESH_OWNER={{ spire_mesh_owner_label }}   # marks what cleanup may remove
export CSI_DRIVER={{ spire_csi_driver_name }}
export CATALOG={{ spire_catalog_source }}

# lab <cluster> - point oc at that cluster and set $TD, $PEER_TD, $APPS,
# $PEER_APPS, $SPIRE_SC and $M (the directory your manifests go in).
# `lab` alone says which clusters there are.
lab() {
    if [ $# -eq 0 ]; then
        echo "lab $FIRST | lab $SECOND   (now: ${CLUSTER:-none})"; return 0
    fi
    [ -r "$WS_CLUSTERS/$1.env" ] || { echo "no $WS_CLUSTERS/$1.env - run the prep step for $1"; return 1; }
    . "$WS_CLUSTERS/$1.env"
    mkdir -p "$M"
    echo "oc -> $CLUSTER ($TD), manifests in $M"
}

# Every helper below prints what it is about to do before doing it, on
# stderr so it never ends up in a file you redirect to:
#   + call client https://echo-spiffe-demo.apps.sno.mylab.com/ spiffe://...   the call, variables expanded
#     = oc -n spiffe-demo exec deploy/client -c app -- python3 ...            the command it runs
# LAB_ECHO=0 turns that off.
_q() {      # quote words for display, the way you would type them
    local a out=""
    for a in "$@"; do
        if [[ $a == *\'* ]]; then          # has single quotes: double-quote it, as typed
            local d=${a//\\/\\\\}
            d=${d//\"/\\\"}; d=${d//\$/\\\$}; d=${d//\`/\\\`}
            out+=" \"$d\""
        elif [[ -z $a || $a =~ [[:space:]\"\$\\\;\|\&\<\>\(\)\*\?] ]]; then
            out+=" '$a'"
        else
            out+=" $a"
        fi
    done
    printf '%s' "${out# }"
}
_show() { [ "${LAB_ECHO:-1}" = 0 ] || printf '+ %s\n' "$(_q "$@")" >&2; }
_run()  { [ "${LAB_ECHO:-1}" = 0 ] || printf '  = %s\n' "$(_q "$@")" >&2; "$@"; }

# spire <args> - the spire-server CLI inside the SPIRE server pod
#   same as: oc -n $ZT_NS exec spire-server-0 -c spire-server -- {{ spire_server_cli }} <args>
#   (/proc/1/exe is the server process's own binary: the image puts
#   spire-server neither on $PATH nor at /opt/spire/bin)
spire() {
    _show spire "$@"
    _run oc -n "$ZT_NS" exec spire-server-0 -c spire-server -- {{ spire_server_cli }} "$@"
}

# inpod <deployment> <cmd...> - run a command in a demo pod's app container
#   same as: oc -n $DEMO_NS exec deploy/<deployment> -c app -- <cmd...>
inpod() { _show inpod "$@"; _inpod "$@"; }
_inpod() { local d=$1; shift; _run oc -n "$DEMO_NS" exec "deploy/$d" -c app -- "$@"; }

# call <from> <url> <expected server SPIFFE ID> [--no-cert]
#   same as: inpod <from> python3 /app/spiffe_client.py <url> <id> [--no-cert]
call() { _show call "$@"; local d=$1; shift; _inpod "$d" python3 /app/spiffe_client.py "$@"; }

# bq_status - checkoutservice's ghostunnel /_status, through the API server's
#   pod proxy. backend_ok: a full mTLS handshake to the paymentservice just
#   succeeded, its SPIFFE ID checked.
bq_status() {
    local pod
    _show bq_status
    pod=$(oc -n "$BQ_NS" get pod -l app=checkoutservice -o jsonpath='{.items[0].metadata.name}') || return 1
    _run oc get --raw "/api/v1/namespaces/$BQ_NS/pods/http:$pod:{{ spire_boutique_status_port }}/proxy/_status"; echo
}

# svid <deployment> - the SPIFFE ID, validity and issuer of a pod's X.509-SVID
svid() {
    _show svid "$@"
    _inpod "$1" python3 -c 'import ssl,json; c=ssl._ssl._test_decode_cert("/svid/svid.pem"); print(json.dumps({k:c[k] for k in ("subjectAltName","notBefore","notAfter","issuer")}, indent=1))'
}

# envoy_cert <deployment> - the SPIFFE ID and validity of the certificate a
#   Service Mesh pod's Envoy holds, from Envoy's own admin API
#   same as: oc -n $MESH_NS exec deploy/<deployment> -c istio-proxy -- pilot-agent request GET certs
envoy_cert() {
    _show envoy_cert "$@"
    _run oc -n "$MESH_NS" exec "deploy/$1" -c istio-proxy -- pilot-agent request GET certs |
    python3 -c 'import json, sys
for e in json.load(sys.stdin)["certificates"]:
    for c in e.get("cert_chain", [])[:1]:
        uri = [s["uri"] for s in c.get("subject_alt_names", []) if "uri" in s]
        print(" ".join(uri) or "(no URI SAN)", c["valid_from"], "->", c["expiration_time"])' | sort -u
}
