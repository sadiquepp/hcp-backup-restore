# The tenant ingress, rendered by setup-clab-fabric.
# Read by scripts/udn-web-demo.sh --proxy.
#
#   vm-name|management-ip|port|domain|name:tenant:cluster:addr[,name:tenant:cluster:addr...]
#
# 'name' is the hostname label and 'tenant' is the network namespace the
# backend is dialled inside - they differ once a second cluster joins, because
# green-sno is served out of the green namespace. 'cluster' is there so the
# demo can check the page came from the cluster the route names, which is the
# only thing distinguishing two pods that share a tenant and a subnet.
#
# The backend addresses are what each pod held when this was rendered. They are
# recorded so the demo can tell a stale config from a routing fault: any
# --tags web re-run replaces the pods, changes their addresses, and leaves this
# file - and the haproxy config it describes - behind.
{{ udn_nsclient_vm_name }}|{{ udn_proxy_bind_addr }}|{{ udn_proxy_port }}|{{ udn_proxy_domain }}|{% for b in udn_proxy_backends %}{{ b.label }}:{{ b.tenant }}:{{ b.cluster }}:{{ b.addr }}{% if not loop.last %},{% endif %}{% endfor %}
