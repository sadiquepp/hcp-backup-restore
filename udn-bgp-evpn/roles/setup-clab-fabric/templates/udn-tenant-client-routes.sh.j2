#!/usr/bin/env bash
{% set leaf = 'leaf2' if (clab_topology | default('bgp') == 'evpn') else 'leaf1' %}
# Fabric plumbing for {{ client.name }}, the client for
# {{ client.tenants | join(' and ') }}. Rendered by setup-clab-fabric.
#
# One untagged NIC on the fabric bridge, and one VLAN subinterface per tenant
# this client serves. The VLAN is what selects the tenant: a frame tagged
{% for t in client.tenants %}
{% set _t = udn_bgp_tenants | selectattr('name', 'equalto', t) | first %}
{% if (clab_topology | default('bgp') == 'evpn') and ((_t.topology | default('Layer3')) == 'Layer2') %}
#   {{ '%-6s' | format(t) }} VLAN {{ udn_client_segments[t].vlan }} -> leaf2's L2VNI {{ _t.evpn_mac_vni }} -> {{ t }}'s pods, on-link
{% else %}
#   {{ '%-6s' | format(t) }} VLAN {{ udn_client_segments[t].vlan }} -> {{ leaf }}'s {{ t }} VRF -> {{ t }}'s pods
{% endif %}
{% endfor %}
# and nothing else. There is no VRF in this guest and there must not be: a
# client-side VRF fault would be indistinguishable from the leaf-side VRF fault
# under test, and {{ leaf }} is the thing being tested. This host stays dumb.
#
# Note these VLANs are NOT the tenant handoff VLANs the nodes use. A client on
# those would share a broadcast domain with all three workers, so {{ leaf }} would
# answer with an ICMP redirect and the traffic would go direct - and
# blue-cannot-reach-red would then be proven by 802.1Q rather than by the VRF.
# Off-segment, every packet is genuinely routed by {{ leaf }} out of the tenant's
# own routing table, which is the claim worth proving.
set -euo pipefail
trap 'echo "udn-tenant-client-routes.sh: failed at line $LINENO with status $?" >&2' ERR

MAC="{{ (clab_fabric_mac_prefix ~ ':' ~ ip_list[client.name]) | lower }}"
MTU={{ clab_fabric_mtu }}
# The VLAN children are the last hop to a POD, whose interface is capped by
# the cluster MTU. The parent keeps the fabric MTU; a child may be smaller
# than its parent and here it has to be. See vars.yaml:clab_client_mtu.
CLIENT_MTU={{ clab_client_mtu | default(1400) }}

# No `exit` in the awk program: exiting on the first match closes the pipe
# while `ip` is still writing, `ip` takes SIGPIPE, and with `set -o pipefail`
# plus `set -e` that harmless signal becomes a fatal error. Reading the whole
# list costs nothing.
find_nic() {
    ip -o link show | awk -v mac="$MAC" \
        'tolower($0) ~ mac && !found { gsub(":","",$2); print $2; found = 1 }'
}

# virtio NICs appear early at boot, but 'early' is not 'before network-pre'.
NIC=""
for _ in $(seq 1 30); do
    NIC=$(find_nic)
    [ -n "$NIC" ] && break
    sleep 1
done

if [ -z "$NIC" ]; then
    echo "no interface with MAC $MAC in this VM - the fabric NIC is missing." >&2
    echo "Attach it with: virsh attach-interface {{ client.name }} --type network" >&2
    echo "  --source {{ clab_fabric_network }} --model virtio --mac $MAC --live --config" >&2
    exit 1
fi

ip link set "$NIC" mtu "$MTU" up

# Reverse-path filtering. Phase 3 should not need this: the request goes out
# the tenant VLAN and the reply comes back the same way, because leaf1 routes
# both directions inside one VRF - unlike phase 2, where the request crossed
# the fabric and the reply came back via the node's default gateway. Set loose
# anyway so a genuine isolation result is never confused with an rp_filter
# drop. If you want to see the symmetry for yourself, set these to 1 and the
# tests should still pass.
sysctl -qw net.ipv4.conf.all.rp_filter=2
for i in /proc/sys/net/ipv4/conf/*/rp_filter; do echo 2 > "$i"; done

{% for t in client.tenants %}
{% set seg = udn_client_segments[t] %}
{% set tenant = udn_bgp_tenants | selectattr('name', 'equalto', t) | first %}
# --- {{ t }} : VLAN {{ seg.vlan }} ---------------------------------------------------
VLAN{{ seg.vlan }}="$NIC.{{ seg.vlan }}"
ip link show "$VLAN{{ seg.vlan }}" >/dev/null 2>&1 || \
    ip link add link "$NIC" name "$VLAN{{ seg.vlan }}" type vlan id {{ seg.vlan }}
ip link set "$VLAN{{ seg.vlan }}" mtu "$CLIENT_MTU" up

# Flush before configuring, every run. This device survives a re-run by design, and neither `ip addr replace` nor `ip route
# replace` removes anything: replace only overwrites an address of the SAME
# prefix, or a route we still render. A segment that changes shape between
# phases therefore keeps both shapes at once.
#
# That is not hypothetical - it is how green and purple broke moving to phase 4.
# Their phase-3 config left
#     10.218.10.21/24  and  10.204.0.0/16 via 10.218.10.1
# in the namespace, and 10.218.10.1 is a leaf1 gateway that phase 4 does not
# build. The new on-link address went in alongside, the stale route still
# covered the whole tenant subnet, and every packet went to a gateway that was
# not there. blue, red and orange were unaffected only because their segment is
# identical in both phases, so replace happened to be enough.
ip addr flush dev "$VLAN{{ seg.vlan }}" || true
ip route flush dev "$VLAN{{ seg.vlan }}" || true
{% set l2 = (clab_topology | default('bgp') == 'evpn') and ((tenant.topology | default('Layer3')) == 'Layer2') %}
{% if l2 %}
# {{ t }}'s transport is a macVRF, so this VLAN is not a routed segment with a
# gateway at the far end - it is an access port on the L2VNI, and this client
# is a host in {{ tenant.udn_subnet }} alongside {{ t }}'s pods and {{ t }}-ext.
# There is nothing to route: every pod is on-link, reached by ARP answered out
# of type-2 routes. So one address and no routes at all, which is why the
# gateway and the two ip route lines the other tenants get are absent here.
ip addr replace {{ tenant.evpn_l2_client_host }}/{{ tenant.udn_subnet.split('/')[1] }} dev "$VLAN{{ seg.vlan }}"
{% else %}
ip addr replace {{ seg.prefix }}.{{ udn_client_segment_host_octet }}/{{ clab_fabric_netmask_bits }} dev "$VLAN{{ seg.vlan }}"

# {{ t }}'s pod network. In phase 3 this prefix is {{ tenant.udn_subnet }}, which
{% if (udn_bgp_tenants | selectattr('udn_subnet', 'equalto', tenant.udn_subnet) | list | length) > 1 %}
# is ALSO {{ udn_bgp_tenants | selectattr('udn_subnet', 'equalto', tenant.udn_subnet) | map(attribute='name') | reject('equalto', t) | join(' and ') }}'s. That is why {{ t }} gets its own client VM:
# this route can exist once per host, so a host holding both would reach one
# tenant and silently never reach the other.
{% else %}
# is unique to {{ t }}, so a failure to reach it can only be the VRF.
{% endif %}
ip route replace {{ tenant.udn_subnet }} via {{ seg.prefix }}.{{ udn_client_segment_gw_octet }} dev "$VLAN{{ seg.vlan }}"

# {{ t }}'s external network, where {{ t }}-ext lives. Reachable from here only
# because {{ leaf }} routes it inside the {{ t }} VRF - the same VRF, a second way in.
ip route replace {{ tenant.external_prefix }} via {{ seg.prefix }}.{{ udn_client_segment_gw_octet }} dev "$VLAN{{ seg.vlan }}"
{% endif %}

{% set leak_partners = [] %}
{# Leaking is a phase-3 construct: it is leaf1's `import vrf <other>`, and
   leaf1-frr-evpn.conf.j2 has no equivalent - under EVPN leaf1 holds no tenant
   VRFs at all. Rendering these routes anyway would point a client at a
   destination the fabric never resolves, which fails identically to a working
   isolation boundary and so proves nothing either way. #}
{% for pair in (udn_vrf_leaks | default([])) if clab_topology | default('bgp') != 'evpn' %}
{% if pair[0] == t %}{% set _ = leak_partners.append(pair[1]) %}
{% elif pair[1] == t %}{% set _ = leak_partners.append(pair[0]) %}
{% endif %}
{% endfor %}
{% for other in leak_partners if not l2 %}
{% set otenant = udn_bgp_tenants | selectattr('name', 'equalto', other) | first %}
# {{ other }}'s pods, reached THROUGH {{ t }}. leaf1 has `import vrf {{ other }}` inside the
# {{ t }} VRF, so {{ otenant.udn_subnet }} is resolvable in {{ t }}'s table - one more
# destination on the VLAN this client already has, not a second VLAN. Remove
# the leak from udn_vrf_leaks and this route stops working while everything
# else here carries on, which is the point of leaking being explicit.
ip route replace {{ otenant.udn_subnet }} via {{ seg.prefix }}.{{ udn_client_segment_gw_octet }} dev "$VLAN{{ seg.vlan }}"
{% endfor %}

{% endfor %}
echo "udn-tenant-client-routes.sh: $NIC up, {{ client.tenants | length }} tenant VLAN(s): {% for t in client.tenants %}{{ t }}={{ udn_client_segments[t].vlan }} {% endfor %}"
