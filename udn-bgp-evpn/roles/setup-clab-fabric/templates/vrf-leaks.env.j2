# Deliberate inter-tenant routing on the fabric, rendered by setup-clab-fabric.
# Read by scripts/udn-vrf-isolation.sh.
#
#   tenant-a|tenant-b
#
# Both directions: leaf1 has `import vrf b` inside a and `import vrf a` inside
# b. The test script uses this to tell an INTENDED opening from a leak - an
# off-diagonal cell listed here must be reachable, and one that is not listed
# must not be.
#
# This file is phase-aware, and deliberately empty under EVPN. `import vrf`
# lives in leaf1-frr.conf.j2, the non-EVPN template; leaf1-frr-evpn.conf.j2
# has no equivalent, because under EVPN leaf1 holds no tenant VRFs at all -
# the nodes are VTEPs and the VRFs live on leaf2. Leaking there would be a
# route-target import in each VRF's address-family, not `import vrf`, and it
# is not built yet. Listing the pairs anyway would make the isolation script
# expect four openings the fabric never creates and report them as GAPs.
{% if clab_topology | default('bgp') != 'evpn' %}
{% for pair in udn_vrf_leaks | default([]) %}
{{ pair[0] }}|{{ pair[1] }}
{% endfor %}
{% endif %}
