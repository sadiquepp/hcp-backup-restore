# workshop.env - written by build-lab.sh --workshop (the prep step) from
# vars.yaml. Re-running the step rewrites it; edit vars.yaml, not this.
#
#   source {{ udn_workshop_env_file }}
#   lab hub          # point oc, $ASN and $CLUSTER at the hub
#   lab sno          # ... or at the SNO
#
# Every manifest in workshop.md is written against these names.

{% for c in clab_fabric_clusters %}
export {{ c | upper }}_KUBECONFIG={{ clab_clusters[c].install_folder }}/auth/kubeconfig
export {{ c | upper }}_ASN={{ clab_clusters[c].asn | default(clab_cluster_asn) }}
{% endfor %}

# The fabric. Every cluster node peers with leaf1 over the fabric network;
# leaf1 relays EVPN routes, leaf2 holds the tenant VRFs and the external
# endpoints. Route targets are <spine ASN>:<VNI>.
export FABRIC_CIDR={{ clab_fabric_prefix }}.0/{{ clab_fabric_netmask_bits }}
export LEAF1_IP={{ clab_fabric_prefix }}.{{ clab_fabric_router_octet }}
export LEAF1_ASN={{ clab_leaf1_asn }}
export LEAF2_ASN={{ clab_leaf2_asn }}
export SPINE_ASN={{ clab_spine_asn }}
export LEAF2_VTEP=10.0.0.2

# Node VTEPs: one /32 per node, {{ udn_bgp_vtep_prefix }}.<last octet of the
# node's InternalIP>, on a dummy interface called {{ udn_bgp_vtep_iface }}.
export VTEP_PREFIX={{ udn_bgp_vtep_prefix }}
export VTEP_CIDR={{ udn_bgp_vtep_prefix }}.0/24
export VTEP_IFACE={{ udn_bgp_vtep_iface }}

export FRR_NS={{ udn_bgp_frrk8s_namespace }}

# Every manifest the workshop has you write lands in $M, one directory per
# cluster, and is applied from there - so what was applied, with every
# variable expanded, stays on disk to read, diff and re-apply.
export WS_MANIFESTS={{ udn_workshop_manifest_dir }}
export CLAB_IP={{ (lab_network_prefix ~ '.' ~ ip_list.clab) if clab_deploy_mode == 'vm' else '127.0.0.1' }}
export CLAB_LAB={{ clab_lab_name }}

# lab <cluster> - switch oc, $ASN, $CLUSTER and $M to one cluster.
lab() {
    case "${1:-}" in
{% for c in clab_fabric_clusters %}
        {{ c }}) export KUBECONFIG=${{ c | upper }}_KUBECONFIG ASN=${{ c | upper }}_ASN CLUSTER={{ c }} ;;
{% endfor %}
        *) echo "usage: lab {{ clab_fabric_clusters | join('|') }}" >&2; return 1 ;;
    esac
    export M="$WS_MANIFESTS/$CLUSTER"
    mkdir -p "$M"
    echo "oc -> $CLUSTER ($(oc whoami --show-server 2>/dev/null)), ASN $ASN, manifests in $M"
}

# The containerlab fabric runs on its own VM; these reach into it.
#   leaf1 'show bgp summary'          vtysh on a router (leaf1, leaf2, spine)
#   onleaf2 ip route show vrf blue    any command inside a router
#   ext blue ping -c3 10.200.4.3      a tenant's external endpoint behind leaf2
_clab() { ssh -q -o StrictHostKeyChecking=no root@"$CLAB_IP" "$@"; }
leaf1()   { _clab docker exec "clab-$CLAB_LAB-leaf1" vtysh -c "$*"; }
leaf2()   { _clab docker exec "clab-$CLAB_LAB-leaf2" vtysh -c "$*"; }
spine()   { _clab docker exec "clab-$CLAB_LAB-spine" vtysh -c "$*"; }
onleaf1() { _clab docker exec "clab-$CLAB_LAB-leaf1" "$@"; }
onleaf2() { _clab docker exec "clab-$CLAB_LAB-leaf2" "$@"; }
ext()     { local t="$1"; shift; _clab docker exec "clab-$CLAB_LAB-$t-ext" "$@"; }

# nodevtysh <node> '<vtysh command>' - the cluster side of a BGP session,
# from the frr-k8s pod on that node.
nodevtysh() {
    local pod
    pod=$(oc -n "$FRR_NS" get pods -l component=frr-k8s \
          --field-selector spec.nodeName="$1" -o name | head -1)
    oc -n "$FRR_NS" exec "$pod" -c frr -- vtysh -c "$2"
}

# podip <tenant> [node] - the UDN address of that tenant's test pod
podip() {
    local sel=(-n "udn-$1" -l app=udn-test)
    [[ -n "${2:-}" ]] && sel+=(--field-selector spec.nodeName="$2")
    local pod
    pod=$(oc get pods "${sel[@]}" -o name | head -1)
    oc -n "udn-$1" exec "$pod" -- ip -4 -o addr show ovn-udn1 | awk '{split($4,a,"/"); print a[1]}'
}

# inpod <tenant> <command...> - run a command in that tenant's test pod
inpod() {
    local t="$1"; shift
    oc -n "udn-$t" exec "$(oc -n "udn-$t" get pods -l app=udn-test -o name | head -1)" -- "$@"
}
